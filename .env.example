# =============================================================================
# InvoiceFlow environment configuration
# Copy to .env and adjust:  cp .env.example .env
# NEVER commit .env. All values below are placeholders.
# =============================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by the docker-compose "db" service) --------------------
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=invoiceflow

# --- Database ----------------------------------------------------------------
# Local (non-Docker) development. docker-compose overrides this to point at "db".
DATABASE_URL=postgresql://invoiceflow:change-me-db-password@localhost:5432/invoiceflow

# --- Auth --------------------------------------------------------------------
# Generate a strong key (required, >= 32 chars, in production):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS / links ------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173

# --- File storage ------------------------------------------------------------
# STORAGE_BACKEND: local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=2
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Feature toggles ---------------------------------------------------------
SCHEDULER_ENABLED=true
RATE_LIMIT_ENABLED=true

# --- Frontend (baked in at build time) ---------------------------------------
VITE_API_URL=http://localhost:8000
